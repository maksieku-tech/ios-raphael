index 0000000..a928859
--- /dev/null
+++ b/bsd/dev/sweet_device.c
@@ -0,0 +1,107 @@
+/* By Maksieku */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include "sweet_device.h"
+
+static bool
+sweet_dev_prop(const char *key, void const **data, unsigned int *size)
+{
+	DTEntry node;
+
+	if (SecureDTLookupEntry(NULL, "/sweet-device", &node) != kSuccess) {
+		return false;
+	}
+	return SecureDTGetProperty(node, key, data, size) == kSuccess;
+}
+
+uint32_t
+sweet_dev_u32(const char *key, uint32_t def)
+{
+	void const *data = NULL;
+	unsigned int size = 0;
+
+	if (!sweet_dev_prop(key, &data, &size) || data == NULL) {
+		return def;
+	}
+	if (size == sizeof(uint32_t)) {
+		uint32_t v;
+		memcpy(&v, data, sizeof(v));
+		return v;
+	}
+	if (size == sizeof(uint64_t)) {
+		uint64_t v;
+		memcpy(&v, data, sizeof(v));
+		return (uint32_t)v;
+	}
+	return def;
+}
+
+uint64_t
+sweet_dev_u64(const char *key, uint64_t def)
+{
+	void const *data = NULL;
+	unsigned int size = 0;
+
+	if (!sweet_dev_prop(key, &data, &size) || data == NULL) {
+		return def;
+	}
+	if (size == sizeof(uint64_t)) {
+		uint64_t v;
+		memcpy(&v, data, sizeof(v));
+		return v;
+	}
+	if (size == sizeof(uint32_t)) {
+		uint32_t v;
+		memcpy(&v, data, sizeof(v));
+		return v;
+	}
+	return def;
+}
+
+unsigned
+sweet_dev_u32_array(const char *key, uint32_t *out, unsigned max)
+{
+	void const *data = NULL;
+	unsigned int size = 0;
+
+	if (!sweet_dev_prop(key, &data, &size) || data == NULL || (size % sizeof(uint32_t)) != 0) {
+		return 0;
+	}
+	unsigned n = size / sizeof(uint32_t);
+	if (n > max) {
+		n = max;
+	}
+	memcpy(out, data, n * sizeof(uint32_t));
+	return n;
+}
+
+bool
+sweet_dev_str(const char *key, char *out, size_t len)
+{
+	void const *data = NULL;
+	unsigned int size = 0;
+
+	if (len == 0 || !sweet_dev_prop(key, &data, &size) || data == NULL || size == 0) {
+		return false;
+	}
+	size_t n = size < len ? size : len - 1;
+	memcpy(out, data, n);
+	out[n] = '\0';
+	return true;
+}
+
+const char *
+sweet_dev_name(void)
+{
+	static char name[32];
+
+	if (name[0] == '\0' && !sweet_dev_str("device", name, sizeof(name))) {
+		strlcpy(name, "sweet", sizeof(name));
+	}
+	return name;
+}
+#endif
