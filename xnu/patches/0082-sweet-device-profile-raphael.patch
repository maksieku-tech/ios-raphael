+}
+
+static int
+touch_gt9886_wake(void)
+{
+	uint8_t stat = 0;
+	int err = touch_write_reg((uint8_t)tc.addr, GT9886_DOZE_CTRL, 0xaa);
+	for (unsigned i = 0; !err && i < 10; ++i) {
+		touch_wait(10);
+		err = touch_read((uint8_t)tc.addr, GT9886_DOZE_STAT, true, &stat, 1);
+		if (!err && stat == 0xbb) {
+			return 0;
+		}
+		if (!err && stat != 0xaa) {
+			err = touch_write_reg((uint8_t)tc.addr, GT9886_DOZE_CTRL, 0xaa);
+		}
+	}
+	printf("SWEET TOUCH: GT9886 doze disable err=%d stat=%#x\n", err, stat);
+	return err ? err : ETIMEDOUT;
+}
+
+static void
+touch_flip(unsigned *px, unsigned *py)
+{
+	if (tc.flip & 1u) {
+		*px = tc.max_x - *px;
+	}
+	if (tc.flip & 2u) {
+		*py = tc.max_y - *py;
+	}
+}
+
+static int
+touch_gt9886_ack(void)
+{
+	return touch_write_reg((uint8_t)tc.addr, GT9886_COORD_REG, 0);
+}
+
+static int
+touch_gt9886(void)
+{
+	uint8_t buf[4 + 8 * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read((uint8_t)tc.addr, GT9886_COORD_REG, true, buf, 12);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		if (buf[0] & 0x40u) {
+			return ENOTSUP;
+		}
+		return 0;
+	}
+	unsigned n = buf[1] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_gt9886_ack();
+		return EIO;
+	}
+	if (n > 1) {
+		err = touch_read((uint8_t)tc.addr, GT9886_COORD_REG + 12u, true, buf + 12, (n - 1u) * 8u);
+		if (err) {
+			(void)touch_gt9886_ack();
+			return err;
+		}
+	}
+	uint8_t sum = 0;
+	for (unsigned i = 0; i < n * 8u + 4u; ++i) {
+		sum += buf[i];
+	}
+	if (sum != 0) {
+		(void)touch_gt9886_ack();
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 2u + i * 8u;
+		if (i + 1u == n && p[0] >= 0x80u) {
+			break;
+		}
+		unsigned id = p[0] & 15u;
+		unsigned px = p[1] | ((unsigned)p[2] << 8), py = p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id)) || px > tc.max_x || py > tc.max_y) {
+			(void)touch_gt9886_ack();
+			return EIO;
+		}
+		touch_flip(&px, &py);
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = touch_gt9886_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
