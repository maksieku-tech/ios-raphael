+void
+AppleCLCD::setupPanelKick(void)
+{
+	fKick = NULL;
+	fKicks = 0;
+	uint64_t ctl = sweet_dev_u64("panel-ctl-start", 0);
+	if (ctl == 0) {
+		return;
+	}
+	uint32_t force = 0;
+	PE_parse_boot_argn("sweetfb_kick", &force, sizeof(force));
+	if (force == 0) {
+		IOLog("SWEET FB: command-mode panel left in ABL autorefresh; no software kick (sweetfb_kick=1 to force)\n");
+		return;
+	}
+	uint32_t autorefresh = 0;
+	vm_offset_t va = ml_io_map((vm_offset_t)ctl, sizeof(uint32_t));
+	if (va == 0) {
+		IOLog("SWEET FB: CTL_START map failed\n");
+		return;
+	}
+	uint32_t hz = 30;
+	PE_parse_boot_argn("sweetfb_kick_hz", &hz, sizeof(hz));
+	fKickTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
+	fKick = (volatile uint32_t *)va;
+	IOLog("SWEET FB: command-mode panel, autorefresh %#x: CTL_START kick at %#llx every %u vsync(s)\n",
+	    autorefresh, ctl, fKickTicks);
+}
+
+void
+AppleCLCD::kickPanel(void)
+{
+	if (fKick == NULL || (fVsyncCount % fKickTicks) != 0) {
+		return;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*fKick = 1;
+	if (++fKicks == 1) {
+		IOLog("SWEET FB: first panel kick\n");
+	}
+}
