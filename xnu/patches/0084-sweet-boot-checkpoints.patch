diff --git a/osfmk/arm64/sweet_heartbeat.c b/osfmk/arm64/sweet_heartbeat.c
new file mode 100644
index 0000000..244e373
--- /dev/null
+++ b/osfmk/arm64/sweet_heartbeat.c
@@ -0,0 +1,47 @@
+/* By Maksieku */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <mach/mach_types.h>
+#include <kern/thread.h>
+#include <kern/sched.h>
+#include <kern/sched_prim.h>
+#include <kern/clock.h>
+#include <kern/misc_protos.h>
+#include <pexpert/pexpert.h>
+
+void sweet_heartbeat_start(void);
+
+static uint32_t sweet_hb_secs;
+static int sweet_hb_event;
+
+static void
+sweet_hb_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	for (;;) {
+		assert_wait_timeout((event_t)&sweet_hb_event, THREAD_UNINT, sweet_hb_secs, NSEC_PER_SEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		uint64_t ns = 0;
+		absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+		kprintf("SWEET HB: %llu s\n", ns / NSEC_PER_SEC);
+	}
+}
+
+void
+sweet_heartbeat_start(void)
+{
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("sweethb", &sweet_hb_secs, sizeof(sweet_hb_secs)) || sweet_hb_secs == 0) {
+		return;
+	}
+	if (sweet_hb_secs > 3600) {
+		sweet_hb_secs = 3600;
+	}
+	if (kernel_thread_start_priority(sweet_hb_thread, NULL, MAXPRI_KERNEL, &thread) != KERN_SUCCESS) {
+		kprintf("SWEET HB: thread start failed\n");
+		return;
+	}
+	thread_set_thread_name(thread, "sweet_heartbeat");
+	thread_deallocate(thread);
+	kprintf("SWEET HB: every %u s\n", sweet_hb_secs);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
